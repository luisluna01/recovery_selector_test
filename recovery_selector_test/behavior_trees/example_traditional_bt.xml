<root BTCPP_format="4">
    <BehaviorTree ID="ExampleTraditionalBT">
        <ReactiveFallback>
            
            <InRoom condition_bool="{in_room}"/>
            
            <!-- Walk in the room -->
            <ReactiveSequence>
                <DoorOpen condition_bool="{door_open}"/> <!-- Condition Node -->
                
                <ReactiveFallback>    
                    <!-- WalkInRoom -->
                    <ReactiveSequence>
                        <ObstacleFreePath condition_bool="{obstacle_free_path}"/> <!-- Condition Node -->
                        <WalkInRoom result="{in_room}" failure_case_bool="{obstacle_free_path}"/>
                    </ReactiveSequence>

                    <!-- Replan trajectory if obstacle present -->
                    <Fallback>
                        <PlanObstacleFreePath result="{obstacle_free_path}" failure_case_bool="{not_needed}"/>

                        <!-- Request user intervention if no obstacle free trajectory is not found -->
                        <Sequence>
                            <!-- RequestUserIntervention -->
                            <PlanObstacleFreePath result="{obstacle_free_path}" failure_case_bool="{not_needed}"/>
                        </Sequence>
                    </Fallback>
                </ReactiveFallback>

            </ReactiveSequence>

            <!-- Open the door -->
            <ReactiveSequence>

                <NearDoor condition_bool="{near_door}"/> <!-- Condition Node -->
                
                <ReactiveFallback>

                    <!-- Push Door Open -->
                    <Sequence>
                        <HandleTurned condition_bool="{handle_turned}"/> <!-- Condition Node -->
                        <PushDoorOpen result="{door_open}" failure_case_bool="{not_needed}"/>
                    </Sequence>
                    
                    <!-- Turn Handle -->
                    <Sequence>
                        <HandleGrasped condition_bool="{handle_grasped}"/> <!-- Condition Node-->
                        <TurnHandle result="{handle_turned}" failure_case_bool="{door_unlocked}"/>
                    </Sequence>

                    <!-- Grasp Handle -->
                    <Sequence>
                        <DoorUnlocked condition_bool="{door_unlocked}"/> <!-- Condition Node -->

                        <Fallback>
                            <GraspHandle result="{handle_grasped}" failure_case_bool="{handle_grasped}"/>

                            <!-- Realign gripper and regrasp handle if previoud handle grasp failed -->
                            <Sequence>
                                <RealignGripper result="{not_needed}" failure_case_bool="{not_needed}"/>
                                <GraspHandle result="{handle_grasped}" failure_case_bool="{handle_grasped}"/>
                            </Sequence>
                        </Fallback>
                    </Sequence>

                    <!-- Unlock door if TurnHandle failed due to door being locked -->
                    <Fallback>
                        <UnlockDoor result="{door_unlocked}" condition_undone="{handle_grasped}" failure_case_bool="{door_unlocked}"/>
                    </Fallback>

                </ReactiveFallback>

            </ReactiveSequence>

            <!-- Walk up to the door -->
            <ReactiveFallback>
                
                <!-- WalkToDoor -->
                <ReactiveSequence>
                    <ObstacleFreePath condition_bool="{obstacle_free_path}"/> <!-- Condition Node -->
                    <WalkToDoor result="{near_door}" failure_case_bool="{failure_case_bool}"/>
                </ReactiveSequence>

                <!-- Replan trajectory if obstacle present -->
                <Fallback>
                    <PlanObstacleFreePath result="{obstacle_free_path}" failure_case_bool="{failure_case_bool}"/>

                    <!-- Request user intervention if no obstacle free trajectory is not found -->
                    <Sequence>
                        <!-- RequestUserIntervention -->
                        <PlanObstacleFreePath result="{obstacle_free_path}" failure_case_bool="{failure_case_bool}"/>
                    </Sequence>
                </Fallback>

            </ReactiveFallback>

        </ReactiveFallback>        
    </BehaviorTree>
</root>
