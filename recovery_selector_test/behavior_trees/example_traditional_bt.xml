<root BTCPP_format="4">
    <BehaviorTree ID="ExampleTraditionalBT">
        <ReactiveFallback name="6">
            
            <InRoom condition_bool="{in_room}"/>
            
            <!-- Walk in the room -->
            <ReactiveSequence>
                <DoorOpen condition_bool="{door_open}"/> <!-- Condition Node -->
                
                <ReactiveFallback>
                    <ReactiveSequence>
                        <GripperStowed condition_bool="{gripper_stowed}"/>

                        <ReactiveFallback>    
                            <!-- WalkInRoom -->
                            <ReactiveSequence>
                                <ObstacleFreePath condition_bool="{obstacle_free_path}"/> <!-- Condition Node -->
                                <WalkInRoom result="{in_room}" failure_case_bool="{obstacle_free_path}"/>
                            </ReactiveSequence>

                            <!-- Replan trajectory if obstacle present -->
                            <Fallback>
                                <PlanObstacleFreePath result="{obstacle_free_path}" failure_case_bool="{not_needed}"/>

                                <!-- Request user intervention if no obstacle free trajectory is not found -->
                                <Sequence>
                                    <SimpleRequestUserIntervention service_name="/user_intervention"/>
                                    <PlanObstacleFreePath result="{obstacle_free_path}" failure_case_bool="{not_needed}"/>
                                </Sequence>
                            </Fallback>
                        </ReactiveFallback>
                    </ReactiveSequence>

                    <ReleaseAndStowGripper result="{gripper_stowed}" condition_undone="{not_needed}" failure_case_bool="{not_needed}"/>
                </ReactiveFallback>

            </ReactiveSequence>

            <!-- Open the door -->
            <ReactiveSequence name="5">

                <NearDoor condition_bool="{near_door}"/> <!-- Condition Node -->
                
                <ReactiveFallback  name="4">

                    <!-- Push Door Open -->
                    <ReactiveSequence>
                        <HandleTurned condition_bool="{handle_turned}"/> <!-- Condition Node -->
                        <PushDoorOpen result="{door_open}" condition_undone="{gripper_stowed}" failure_case_bool="{not_needed}"/>
                    </ReactiveSequence>
                    
                    <!-- Turn Handle -->
                    <ReactiveSequence>
                        <HandleGrasped condition_bool="{handle_grasped}"/> <!-- Condition Node-->
                        <DoorUnlocked condition_bool="{door_unlocked}"/> <!-- Condition Node -->
                        <TurnHandle result="{handle_turned}" condition_undone="{gripper_stowed}" failure_case_bool="{door_unlocked}"/>
                    </ReactiveSequence>

                    <!-- Grasp Handle -->
                    <Sequence  name="3">
                        <DoorUnlocked condition_bool="{door_unlocked}"/> <!-- Condition Node -->

                        <!-- Stow gripper if it is not already stowed -->
                        <Fallback>
                            <GripperStowed condition_bool="{gripper_stowed}"/>
                            <ReleaseAndStowGripper result="{gripper_stowed}" condition_undone="{handle_grasped}" failure_case_bool="{not_needed}"/>
                        </Fallback>

                        <Fallback  name="2">
                            <GraspHandle result="{handle_grasped}" condition_undone="{gripper_stowed}" failure_case_bool="{handle_grasped}"/>

                            <!-- Realign gripper and regrasp handle if previoud handle grasp failed -->
                            <Sequence name="1">
                                <ReleaseAndStowGripper result="{gripper_stowed}" condition_undone="{handle_grasped}" failure_case_bool="{not_needed}"/>
                                <SlowlyRegraspHandle result="{handle_grasped}" condition_undone="{gripper_stowed}" failure_case_bool="{not_needed}"/>
                            </Sequence>
                        </Fallback>
                    </Sequence>

                    <!-- Unlock door if TurnHandle failed due to door being locked -->
                    <Sequence>
                        <ReleaseAndStowGripper result="{gripper_stowed}" condition_undone="{handle_grasped}" failure_case_bool="{not_needed}"/>
                        <UnlockDoor result="{door_unlocked}" condition_undone="{gripper_stowed}" failure_case_bool="{door_unlocked}"/>
                    </Sequence>

                </ReactiveFallback>

            </ReactiveSequence>
            
            <!-- Walk up to the door -->
            <ReactiveSequence>
            
                <GripperStowed condition_bool="{gripper_stowed}"/>
                
                <ReactiveFallback>
                    <ReactiveSequence>
                        <ObstacleFreePath condition_bool="{obstacle_free_path}"/> <!-- Condition Node -->
                        <WalkToDoor result="{near_door}" failure_case_bool="{obstacle_free_path}"/>
                    </ReactiveSequence>

                    <Fallback>
                        <PlanObstacleFreePath result="{obstacle_free_path}" failure_case_bool="{obstacle_free_path}"/>

                        <!-- Request user intervention if no obstacle free trajectory is not found -->
                        <Sequence>
                            <SimpleRequestUserIntervention service_name="/user_intervention"/>
                            <PlanObstacleFreePath result="{obstacle_free_path}" failure_case_bool="{obstacle_free_path}"/>
                        </Sequence>
                    </Fallback>
                </ReactiveFallback>

            </ReactiveSequence>
            <ReleaseAndStowGripper result="{gripper_stowed}" condition_undone="{handle_grasped}" failure_case_bool="{not_needed}"/>

        </ReactiveFallback>        
    </BehaviorTree>
</root>
