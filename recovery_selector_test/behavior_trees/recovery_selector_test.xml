<!-- Templated Tree -->
<root BTCPP_format="4">
    <BehaviorTree ID="RecoverySelectorTest">
        <Parallel success_count="1" failure_count="1">
            <CreateDummyFailure topic="/failure_source" failure_state="{failure_state}"/>

            <ReactiveFallback>
                <!-- Only use when ticking rate is <= 100ms -->
                <!-- <Print message="~~~~~~~~~~ ticking tree ~~~~~~~~~~"/> --> 
                
                <ReactiveSequence>
                    <NoFailuresPresent failure_state="{failure_state}"/>
                    
                    <!-- ~~~~~ Main Task ~~~~~ -->
                    <ReactiveFallback>
                        <ReconstructionComplete condition_bool="{reconstruction_complete}"/>
                        <ReconstructObject result="{reconstruction_complete}"/>
                    </ReactiveFallback>

                    <ReactiveFallback>
                        <GraspsDetected condition_bool="{grasps_detected}"/>
                        <GeneratePredictedGrasps result="{grasps_detected}"/>
                    </ReactiveFallback>
                    
                    <ReactiveFallback>
                        <PipeGrasped condition_bool="{pipe_grasped}"/>
                        <GraspPipe result="{pipe_grasped}"/>
                    </ReactiveFallback>
                    <!-- ~~~~~ Main Task ~~~~~ -->
                </ReactiveSequence>

                <RecoverySelector failure_state="{failure_state}" case_1="LOW_BATTERY" case_2="MOTOR_FAILURE" case_3="FAILED_GRASP">
                    <!-- Low Battery -->
                    <RecoverFromLowBattery failure_state="{failure_state}"/>

                    <!-- Motor Failure -->
                    <RecoverFromMotorFailure failure_state="{failure_state}"/>

                    <!-- Failed Grasp -->
                    <RecoverFromFailedGrasp failure_state="{failure_state}"/>

                    <!-- Default -->
                    <Sequence>
                        <GracefulShutdown/>
                        
                        <AlwaysFailure/> <!-- Important to abort tree -->
                    </Sequence>
                </RecoverySelector>

            </ReactiveFallback>
        </Parallel>
    </BehaviorTree>
</root>
