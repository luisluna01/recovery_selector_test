<root BTCPP_format="4">
    <BehaviorTree ID="ExampleRecoverySelectorBT">
        <ReactiveSequence>

            <!-- Recovery Branch -->
            <RecoverySelector failure_state="{failure_state}" case_1="OBSTACLE_IN_PATH" case_2="DOOR_LOCKED" case_3="FAILED_GRASP">
                <PlanObstacleFreePath failure_state="{failure_state}"/>
                
                <Sequence>
                    <ReleaseAndStowGripper result="{gripper_stowed}" condition_undone="{handle_grasped}" failure_state="{failure_state}"/>
                    <UnlockDoor condition_undone="{gripper_stowed}" failure_state="{failure_state}"/>
                </Sequence>
                
                <Sequence>
                    <ReleaseAndStowGripper result="{gripper_stowed}" condition_undone="{handle_grasped}" failure_state="{failure_state}"/>
                    <SlowlyRegraspHandle result="{handle_grasped}" failure_state="{failure_state}"/>
                </Sequence>

                    <RequestUserIntervention service_name="/user_intervention" failure_state="{failure_state}"/>
            </RecoverySelector>
            
            <!-- Main Branch -->
            <Inverter>
                <KeepRunningUntilFailure>
                    <Inverter>
                        <ReactiveFallback name="MainTask">
                            <InRoom condition_bool="{in_room}"/>

                            <!-- Walk to Room -->
                            <ReactiveSequence>
                                <DoorOpen condition_bool="{door_open}"/>

                                <ReactiveFallback>
                                    <GripperStowed condition_bool="{gripper_stowed}"/>
                                    <ReleaseAndStowGripper result="{gripper_stowed}" condition_undone="{handle_turned}" condition_undone_2="{handle_grasped}" failure_state="{failure_state}"/>
                                </ReactiveFallback>

                                <WalkInRoom result="{in_room}" failure_state="{failure_state}"/>
                            </ReactiveSequence>

                            <!-- Open Door -->
                            <ReactiveSequence>
                                <NearDoor condition_bool="{near_door}"/>

                                <ReactiveFallback>
                                    <ReactiveSequence>
                                        <HandleTurned condition_bool="{handle_turned}"/>
                                        <PushDoorOpen result="{door_open}" condition_undone="{gripper_stowed}" failure_state="{failure_state}"/>
                                    </ReactiveSequence>

                                    <ReactiveSequence>
                                        <HandleGrasped condition_bool="{handle_grasped}"/>
                                        <TurnHandle result="{handle_turned}" condition_undone="{gripper_stowed}" failure_state="{failure_state}"/>
                                    </ReactiveSequence>

                                    <Sequence>
                                        <GripperStowed condition_bool="{gripper_stowed}"/>
                                        <GraspHandle result="{handle_grasped}" condition_undone="{gripper_stowed}" failure_state="{failure_state}"/>
                                    </Sequence>
                                </ReactiveFallback>
                            </ReactiveSequence>
                            
                            <!-- Walk to Door -->
                            <ReactiveSequence>
                                <GripperStowed condition_bool="{gripper_stowed}"/>
                                <WalkToDoor result="{near_door}" failure_state="{failure_state}"/>
                            </ReactiveSequence>
                            <ReleaseAndStowGripper result="{gripper_stowed}" condition_undone="{handle_grasped}" failure_state="{failure_state}"/>

                        </ReactiveFallback>
                    </Inverter>
                </KeepRunningUntilFailure>
            </Inverter>

        </ReactiveSequence>
    </BehaviorTree>
</root>
