<!-- Templated Tree -->
<root BTCPP_format="4" >
    <BehaviorTree ID="TestRecoverySelector">
        <ReactiveSequence>

            <CauseFailure failure_state="{failure_state}"/>

            <PerformTask/>
            
            <RecoverySelector failure_state="{failure_state}" case_1="{case_a}" case_2="{case_b}" case_3="{case_c}">
                <RecoveryA failure_state="{failure_state}"/>
                <RecoveryB failure_state="{failure_state}"/>
                <RecoveryC failure_state="{failure_state}"/>
            </RecoverySelector>
        
        </ReactiveSequence>
    </BehaviorTree>
</root>
