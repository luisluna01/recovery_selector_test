<!-- Templated Tree -->
<root BTCPP_format="4">
    <BehaviorTree ID="TestRecoverySelector">
        <ReactiveSequence>

            <!-- TODO: Replace GetMessageFromTopic with CauseFailure -->
            <!-- <CauseFailure failure_state="{failure_state}" failure_topic="/test_recovery_selector/failure_source"/> -->
            <ForceSuccess>
                <GetMessageFromTopic topic="/failure_source" type="std_msgs::msg::String" timeout="0.0" value="{failure_state}"/>
            </ForceSuccess>
            
            <!-- TODO: Replace Print with PerformTask -->
            <!-- <PerformTask/> -->
            <Print message="Agent behaving as expected..."/>
            
            <RecoverySelector failure_state="{failure_state}" case_1="a" case_2="b" case_3="c">
                <!-- <RecoveryA failure_state="{failure_state}"/> -->
                <Print message="Case A resolving..."/>

                <!-- <RecoveryB failure_state="{failure_state}"/> -->
                <Print message="Case B resolving..."/>

                <!-- <RecoveryC failure_state="{failure_state}"/> -->
                <Print message="Case C resolving..."/>
            </RecoverySelector>
        
        </ReactiveSequence>
    </BehaviorTree>
</root>
