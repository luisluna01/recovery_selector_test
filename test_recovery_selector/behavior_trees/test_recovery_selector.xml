<!-- Templated Tree -->
<root BTCPP_format="4">
    <BehaviorTree ID="TestRecoverySelector">
        <Parallel success_count="1" failure_count="1">
            <CreateDummyFailure topic="/failure_source" failure_state="{failure_state}"/>

            <ReactiveSequence>
                <!-- <ForceSuccess>
                    <Print message="{failure_state}"/>
                </ForceSuccess> -->

                <!-- <Switch3 variable="{failure_state}" case_1="a" case_2="b" case_3="c">
                    <Print message="Case A resolving..."/>

                    <Print message="Case B resolving..."/>

                    <Print message="Case C resolving..."/>

                    <Print message="Default: No failures..."/>
                </Switch3> -->
                <RecoverySelector failure_state="{failure_state}" case_1="a" case_2="b" case_3="c">

                    <DummyRecoveryStrategyA failure_state="{failure_state}" completion_time="5"/>

                    <DummyRecoveryStrategyB failure_state="{failure_state}" completion_time="5"/>

                    <DummyRecoveryStrategyC failure_state="{failure_state}" completion_time="5"/>

                    <AlwaysSuccess/>
                </RecoverySelector>

                <DummyTask completion_time="10"/>
            </ReactiveSequence>
        </Parallel>
    </BehaviorTree>
</root>
