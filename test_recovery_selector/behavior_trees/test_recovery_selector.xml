<!-- Templated Tree -->
<root BTCPP_format="4">
    <BehaviorTree ID="TestRecoverySelector">
        <Parallel success_count="1" failure_count="1">
            <CreateDummyFailure topic="/failure_source" failure_state="{failure_state}"/>

            <ReactiveSequence>
                <!-- Only use when ticking rate is <= 100ms -->
                <!-- <Print message="~~~~~~~~~~ ticking tree ~~~~~~~~~~"/> -->

                <!-- <Switch3 variable="{failure_state}" case_1="a" case_2="b" case_3="c">
                    <Print message="Case A resolving..."/>

                    <Print message="Case B resolving..."/>

                    <Print message="Case C resolving..."/>

                    <Print message="Default: No failures..."/>
                </Switch3> -->
                <RecoverySelector failure_state="{failure_state}" case_1="LOW_BATTERY" case_2="MOTOR_FAILURE" case_3="FAILED_GRASP">

                    <!-- Low Battery -->
                    <RecoveryStrategyA failure_state="{failure_state}" completion_time="10"/>

                    <!-- Motor Failure -->
                    <RecoveryStrategyB failure_state="{failure_state}" completion_time="10"/>

                    <!-- Failed Grasp -->
                    <RecoveryStrategyC failure_state="{failure_state}" completion_time="10"/>

                    <AlwaysSuccess/>
                </RecoverySelector>
                
                <!-- ~~~~~ Main Task ~~~~~ -->
                <ReactiveFallback>
                    <ConditionA condition_bool="{task_a_complete}"/>
                    <TaskA completion_time="10" use_completion_flag="true" completion_flag="{task_a_complete}"/>
                </ReactiveFallback>

                <ReactiveFallback>
                    <ConditionB condition_bool="{task_b_complete}"/>
                    <TaskB completion_time="10" use_completion_flag="true" completion_flag="{task_b_complete}"/>
                </ReactiveFallback>
                
                <ReactiveFallback>
                    <ConditionC condition_bool="{task_c_complete}"/>
                    <TaskC completion_time="10" use_completion_flag="true" completion_flag="{task_c_complete}"/>
                </ReactiveFallback>
                <!-- ~~~~~ Main Task ~~~~~ -->
            </ReactiveSequence>
        </Parallel>
    </BehaviorTree>
</root>
