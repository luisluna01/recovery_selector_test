<!-- Templated Tree -->
<root BTCPP_format="4">
    <BehaviorTree ID="TestRecoverySelector">
        <Parallel success_count="1" failure_count="1">
            <CreateDummyFailure topic="/failure_source" failure_state="{failure_state}"/>

            <ReactiveSequence>
                <!-- <Switch3 variable="{failure_state}" case_1="a" case_2="b" case_3="c">
                    <Print message="Case A resolving..."/>

                    <Print message="Case B resolving..."/>

                    <Print message="Case C resolving..."/>

                    <Print message="Default: No failures..."/>
                </Switch3> -->
                <RecoverySelector failure_state="{failure_state}" case_1="LOW_BATTERY" case_2="MOTOR_FAILURE" case_3="FAILED_GRASP">

                    <!-- Low Battery -->
                    <DummyRecoveryStrategyA failure_state="{failure_state}" completion_time="10"/>

                    <!-- Motor Failure -->
                    <DummyRecoveryStrategyB failure_state="{failure_state}" completion_time="10"/>

                    <!-- Failed Grasp -->
                    <DummyRecoveryStrategyC failure_state="{failure_state}" completion_time="10"/>

                    <AlwaysSuccess/>
                </RecoverySelector>
                
                <ReactiveFallback>
                    <DummyCondition condition_bool="{task_complete}"/>
                    <DummyTask completion_time="20" use_completion_flag="true" completion_flag="{task_complete}"/>
                </ReactiveFallback>
            </ReactiveSequence>
        </Parallel>
    </BehaviorTree>
</root>
