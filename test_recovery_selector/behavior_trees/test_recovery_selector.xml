<!-- Templated Tree -->
<root BTCPP_format="4">
    <BehaviorTree ID="TestRecoverySelector">
        <ReactiveSequence>
            <CreateDummyFailure failure_state="{failure_state}"/>

            <KeepRunningUntilFailure>
                <Print message="Agent behaving as expected..."/>
            </KeepRunningUntilFailure>

            <Switch3 variable="{failure_state}" case_1="a" case_2="b" case_3="c">
                <!-- Case 1 -->
                <Print message="Case A resolving..."/>

                <!-- Case 2 -->
                <Print message="Case B resolving..."/>

                <!-- Case 3 -->
                <Print message="Case C resolving..."/>

                <!-- Default -->
                <Print message="No failures..."/>
            </Switch3>
            
        </ReactiveSequence>
    </BehaviorTree>
</root>

